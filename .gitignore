.venv*/
.cache/
.tmp/
__pycache__/
*.pyc
vendor/
runtime/
# Artifacts stay on disk; curated verification files are committed explicitly.
artifacts/
.env*
*.key
*.pem

# Generated local research state. Original traces are append-only on disk.
/.autoresearch/
/experiments.tsv
/results/
/paper/
/data/*.pt
/data/v2/*.pt
/.autoresearch-v2/
/experiments_v2.tsv
/frozen_method.json
/dist/
# Public upstream documentation snapshots stay local; URL/hash provenance is tracked.
/provenance/closure/arena-*.md
/provenance/closure/arena-*.schema.json
/provenance/closure/socialsim-docs.html

/data/v3/*.pt

# Private signing material and unreleased prospective answers.
/.private/

# Local historical evidence archive; never part of entrant registration.
/archive/
